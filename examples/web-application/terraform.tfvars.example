aws_region            = "us-east-1"
project_name          = "web"
environment           = "development"
vpc_cidr              = "10.80.0.0/16"
availability_zones    = ["us-east-1a", "us-east-1b"]
public_subnet_cidrs   = ["10.80.0.0/24", "10.80.1.0/24"]
private_subnet_cidrs  = ["10.80.16.0/20", "10.80.32.0/20"]
client_cidrs          = ["198.51.100.10/32"] # Replace with approved client CIDRs.
ami_id                = "ami-0123456789abcdef0" # Replace with an approved, current regional AMI.
instance_type         = "t3.micro"
application_port      = 8080
health_check_path     = "/health"
certificate_arn       = "arn:aws:acm:us-east-1:111122223333:certificate/replace-me"
enable_http_redirect  = false
tags                  = { Owner = "platform-team", CostCenter = "replace-me" }
